#!/usr/bin/env bash
# ============================================================
# Git hook: git pull/merge 后显示电脑身份 + 推拉顺序提醒
# 此文件由仓库跟踪，两台电脑共享
# ============================================================

if [ -f "$HOME/.computer-identity" ]; then
    ID=$(cat "$HOME/.computer-identity")
    case "$ID" in
        evan)
            echo ""
            echo "  ╔══════════════════════════════════════╗"
            echo "  ║  当前：新电脑 · 代号 evan            ║"
            echo "  ╠══════════════════════════════════════╣"
            echo "  ║  ✅ pull 完成，可以开始工作          ║"
            echo "  ║  工作完后记得 git push               ║"
            echo "  ╚══════════════════════════════════════╝"
            echo ""
            ;;
        feng)
            echo ""
            echo "  ╔══════════════════════════════════════╗"
            echo "  ║  当前：老电脑 · 代号 feng            ║"
            echo "  ╠══════════════════════════════════════╣"
            echo "  ║  ✅ pull 完成，可以开始工作          ║"
            echo "  ║  工作完后记得 git push               ║"
            echo "  ╚══════════════════════════════════════╝"
            echo ""
            ;;
    esac
fi
