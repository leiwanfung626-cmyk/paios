#!/usr/bin/env bash
# ============================================================
# Git hook: 切换分支/拉取后显示电脑身份 + 推拉顺序提醒
# 此文件由仓库跟踪，两台电脑共享
# ============================================================

if [ -f "$HOME/.computer-identity" ]; then
    ID=$(cat "$HOME/.computer-identity")
    case "$ID" in
        evan)
            echo ""
            echo "  ╔══════════════════════════════════════╗"
            echo "  ║  当前：新电脑 · 代号 evan            ║"
            echo "  ╠══════════════════════════════════════╣"
            echo "  ║  ⚠ 操作前必读：                     ║"
            echo "  ║  ① 先 git pull → 再工作             ║"
            echo "  ║  ② 工作完 git push                   ║"
            echo "  ║  ③ 去老电脑(feng) 先 pull 再继续    ║"
            echo "  ╚══════════════════════════════════════╝"
            echo ""
            ;;
        feng)
            echo ""
            echo "  ╔══════════════════════════════════════╗"
            echo "  ║  当前：老电脑 · 代号 feng            ║"
            echo "  ╠══════════════════════════════════════╣"
            echo "  ║  ⚠ 操作前必读：                     ║"
            echo "  ║  ① 先 git pull → 再工作             ║"
            echo "  ║  ② 工作完 git push                   ║"
            echo "  ║  ③ 去新电脑(evan) 先 pull 再继续    ║"
            echo "  ╚══════════════════════════════════════╝"
            echo ""
            ;;
    esac
fi
